<Window x:Class="LocalVideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LocalVideoPlayer"
        Title="Local Video Player（POC A）" Height="480" Width="860"
        WindowStartupLocation="CenterScreen" Background="#FF20242A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 视频画面宿主 -->
        <Border Grid.Row="0" Margin="8" BorderBrush="#FF3A3F47" BorderThickness="1" Background="#FF101318">
            <local:MpvHost x:Name="VideoHost"/>
        </Border>

        <!-- 控制栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,4,12,4">
            <Button x:Name="OpenButton" Content="打开文件" Width="96" Height="30" Click="OpenButton_Click"/>
            <Button x:Name="PlayButton" Content="播放" Width="72" Height="30" Margin="8,0,0,0" Click="PlayButton_Click"/>
            <Button x:Name="PauseButton" Content="暂停" Width="72" Height="30" Margin="8,0,0,0" Click="PauseButton_Click"/>
            <Button x:Name="StopButton" Content="停止" Width="72" Height="30" Margin="8,0,0,0" Click="StopButton_Click"/>
            <TextBlock x:Name="StatusText" Text="未加载媒体" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#FFC9D1D9" FontSize="13"/>
        </StackPanel>

        <!-- 进度/音量 -->
        <Grid Grid.Row="2" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" IsMoveToPointEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="VolumeText" Text="100%" Width="44" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="#FFC9D1D9" FontSize="12"/>
        </Grid>
    </Grid>
</Window>
